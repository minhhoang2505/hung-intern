# Ép Git luôn dùng line ending LF cho các file code, bất kể cấu hình
# core.autocrlf trên từng máy Windows khác nhau trong team. Không có file
# này, mỗi máy Windows có thể tự chuyển ngược file về CRLF khi checkout/lưu,
# gây lỗi PHPCS "Generic.Files.LineEndings.InvalidEOLChar" lặp lại liên tục.

*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md  text eol=lf