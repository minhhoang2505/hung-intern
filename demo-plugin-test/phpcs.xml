<?xml version="1.0"?>
<ruleset name="Seoulive Core">
	<description>Coding standards cho plugin seoulive-core, dựa trên WordPress Coding Standards (WPCS).</description>

	<rule ref="WordPress">
		<!--
			seoulive-core.php là file bootstrap CHÍNH của plugin (chứa Header
			comment "Plugin Name: ..."), bắt buộc phải giữ đúng tên này để
			WordPress nhận diện và kích hoạt được — không thể đổi sang
			class-seoulive-core-plugin.php như rule WPCS thông thường yêu cầu
			cho các file chứa class. Đây là ngoại lệ chuẩn, mọi plugin
			WordPress single-file đều gặp và loại trừ rule này.
		-->
		<exclude name="WordPress.Files.FileName" />
	</rule>

	<arg name="extensions" value="php" />
	<arg value="sp" />
</ruleset>